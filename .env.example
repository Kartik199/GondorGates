# Copy this file to .env and fill in values before running docker compose.
# .env is listed in .gitignore and must never be committed.

# Grafana admin password.
# Used only for administrative access (datasource management, org settings).
# The dashboard is publicly visible via anonymous access — this password is
# not needed for day-to-day use.
# For any non-local deployment this must be a strong, unique value.
GRAFANA_ADMIN_PASSWORD=
